# Copy this file to .env and fill in your real values. Never commit .env.

# PostgreSQL connection string — point this at the actual database
# (e.g. "postgres"), NOT at a schema name.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Schema inside that database containing the tables from
# server/db/001_schema.sql and server/db/002_seed.sql (defaults to "public")
DB_SCHEMA=public

# Secret used to sign JWTs — set a long random value in any real deployment
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# JSON array of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173"]
